// Two Workers from one config: `previously` (production) and `previously-staging`
// (`CLOUDFLARE_ENV=staging`). They differ only in their domain and in
// CONTENT_ENV, which picks the content manifest. Deployed only from this
// machine with `pnpm deploy:staging` / `pnpm deploy:production` (plan 0001).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "previously",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    // Only these paths run Worker code; everything else is a static asset.
    "run_worker_first": ["/api/*", "/mcp"]
  },
  "vars": { "CONTENT_ENV": "production" },
  "routes": [{ "pattern": "previously.fyi", "custom_domain": true }],
  "env": {
    "staging": {
      "name": "previously-staging",
      "vars": { "CONTENT_ENV": "staging" },
      "routes": [{ "pattern": "staging.previously.fyi", "custom_domain": true }]
    }
  }
}
