// The `previously` Worker (previously.fyi). Deployed only from this machine with
// `pnpm deploy:production` (plan 0001), after a review on this laptop with
// `pnpm dev`. There is no staging site. CONTENT_ENV picks the content manifest.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "previously",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only these paths run Worker code; everything else is a static asset.
    // /show/* runs it to add per-show link-preview tags to the app page.
    "run_worker_first": ["/api/*", "/mcp", "/show/*", "/robots.txt", "/sitemap.xml"]
  },
  "vars": { "CONTENT_ENV": "production" },
  // Show bundles, catalogs and manifests (written by scripts/publish/).
  "r2_buckets": [{ "binding": "CONTENT", "bucket_name": "previously-content" }],
  // Requests per client IP per minute (per Cloudflare location). Claude.ai and
  // ChatGPT call /mcp from shared IPs, so its limit is the higher one. The QA
  // scripts wait and retry when they hit a limit.
  "ratelimits": [
    { "name": "API_LIMIT", "namespace_id": "41001", "simple": { "limit": 600, "period": 60 } },
    { "name": "MCP_LIMIT", "namespace_id": "41002", "simple": { "limit": 1200, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "invocation_logs": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 1 }
  },
  "routes": [{ "pattern": "previously.fyi", "custom_domain": true }]
}
