{
  "name": "previously",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "engines": {
    "node": "^22.23.4 || ^24.22.1",
    "pnpm": ">=11.7.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "wrangler types >/dev/null && tsc -b",
    "validate": "node scripts/validate-all.mjs",
    "check": "pnpm typecheck && pnpm validate && pnpm build",
    "deploy:staging": "node scripts/deploy.mjs staging",
    "deploy:production": "node scripts/deploy.mjs production",
    "rollback:production": "node scripts/deploy.mjs rollback",
    "content:local": "node scripts/publish/publish.mjs local",
    "content:publish": "node scripts/publish/publish.mjs publish",
    "content:qa": "node scripts/publish/promote.mjs qa",
    "content:promote": "node scripts/publish/promote.mjs promote",
    "content:rollback": "node scripts/publish/promote.mjs rollback",
    "deploy:www": "node scripts/deploy.mjs www",
    "og:image": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless=new --disable-gpu --hide-scrollbars --virtual-time-budget=5000 --window-size=1200,630 --screenshot=public/og.png scripts/og-image.html"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "agents": "0.33.0",
    "posthog-js": "1.450.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "wrangler": "4.162.0"
  }
}
